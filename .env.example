# Copy to `.env` and adjust. All variables are prefixed with ABSA_.
# `.env` is gitignored — never commit real secrets.

# --- Runtime ---
ABSA_ENVIRONMENT=development        # development | test | production
ABSA_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
ABSA_LOG_JSON=false                 # true => JSON logs (for prod/serving)
ABSA_SEED=42

# --- Paths (relative to repo root unless absolute) ---
ABSA_DATA_DIR=data
ABSA_ARTIFACTS_DIR=artifacts
ABSA_REPORTS_DIR=reports
ABSA_CONFIGS_DIR=configs

# --- Modeling / inference ---
ABSA_DEVICE=auto                    # auto | cpu | cuda
ABSA_DEFAULT_TRACK=transformer      # baseline | transformer
ABSA_ARTIFACT_PATH=artifacts/absa-transformer-int8
ABSA_MAX_LENGTH=128

# --- Experiment tracking (MLflow) ---
ABSA_MLFLOW_TRACKING_URI=file:./mlruns
ABSA_MLFLOW_EXPERIMENT=absa
